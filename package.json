{
  "name": "hormigestion-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <27" },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "db:seed:demo": "tsx src/infrastructure/database/seed-demo.ts",
    "db:seed:reportes": "tsx src/infrastructure/database/seed-report-demo.ts",
    "db:migrate:prod": "node dist/infrastructure/database/migrate.js",
    "test": "node --import tsx --test --test-isolation=none tests/unit/*.test.ts",
    "test:integration": "tsx scripts/test-integration.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "pino": "^10.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
